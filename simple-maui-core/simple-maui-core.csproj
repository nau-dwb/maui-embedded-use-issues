<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <LangVersion>11</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Nau.Simple.Maui.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseMaui>true</UseMaui>
    <UseMauiEssentials>true</UseMauiEssentials>
    <Nullable>disable</Nullable>

    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">26</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">14.2</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="CommunityToolkit.Maui" Version="15.0.0" />
	<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	  <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
	  <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.90" />
	  <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.90" />
  </ItemGroup>

  <ItemGroup>
	  <MauiXaml Update="FontIconExamplePage.xaml">
		  <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
  </ItemGroup>
</Project>
